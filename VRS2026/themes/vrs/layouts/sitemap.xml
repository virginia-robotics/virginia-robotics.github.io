{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Pages }}{{ if ne .Kind "404" }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>{{ end }}
  </url>
  {{ end }}{{ end }}
  {{- /* The archived previous-year site is static HTML outside Hugo's page tree. */}}
  {{ with .Site.Params.archiveURL }}
  <url>
    <loc>{{ . | absURL }}</loc>{{ with $.Site.Params.archiveLastmod }}
    <lastmod>{{ . }}</lastmod>{{ end }}
  </url>
  {{ end }}
</urlset>
